{
  "name": "Docker Infrastructure (Ansible)",
  "image": "ghcr.io/devsecninja/dotfiles-devcontainer:latest@sha256:ae5730e0f0de08c7be4fd2c41ddce3798e7c41c6f3a3d1dad57044476a796f03",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "dotfiles.repository": "https://github.com/DevSecNinja/dotfiles",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "fish",
        "git.postCommitCommand": "push",
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "search.exclude": {
          "ansible/.ansible": true
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        },
        "yaml.schemas": {
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/playbook": "ansible/playbooks/*.yml",
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/tasks": "ansible/roles/*/tasks/*.yml"
        },
        "ansible.python.interpreterPath": "/usr/local/bin/python3"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ]
}
