{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    "github>DevSecNinja/.github//.renovate/autoMerge.json5",
    "github>DevSecNinja/.github//.renovate/base.json5",
    "github>DevSecNinja/.github//.renovate/customManagers.json5",
    "github>DevSecNinja/.github//.renovate/groups.json5",
    "github>DevSecNinja/.github//.renovate/labels.json5",
    "github>DevSecNinja/.github//.renovate/packageRules.json5",
    "github>DevSecNinja/.github//.renovate/semanticCommits.json5",
  ],
  pip_requirements: {
    managerFilePatterns: ["/requirements\\.txt$/"],
  },
  "ansible-galaxy": {
    managerFilePatterns: ["/requirements\\.ya?ml$/"],
  },
  packageRules: [
    {
      description: "Enable digest updates for DevSecNinja devcontainer images",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["/^ghcr\\.io\\/devsecninja\\//"],
      matchUpdateTypes: ["digest"],
      enabled: true,
      minimumReleaseAge: "0",
    },
    {
      description: "Disable Docker lookups for Dev Container feature references",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["feature"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Track Python version in .mise.toml",
      managerFilePatterns: ["/^\\.mise\\.toml$/"],
      matchStrings: [
        "python\\s*=\\s*\"(?<currentValue>[\\d.]+)\"",
      ],
      depNameTemplate: "python",
      datasourceTemplate: "github-releases",
      packageNameTemplate: "python/cpython",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      customType: "regex",
      description: "Track bats-core version in .mise.toml",
      managerFilePatterns: ["/^\\.mise\\.toml$/"],
      matchStrings: [
        "bats\\s*=\\s*\"(?<currentValue>[\\d.]+)\"",
      ],
      depNameTemplate: "bats-core",
      datasourceTemplate: "github-releases",
      packageNameTemplate: "bats-core/bats-core",
    },
    {
      customType: "regex",
      description: "Track bats-core version in Taskfile and test scripts",
      managerFilePatterns: [
        "/^Taskfile\\.ya?ml$/",
        "/tests/bash/run-tests\\.sh$/",
      ],
      matchStrings: [
        "BATS_VERSION=\"(?<currentValue>[\\d.]+)\"",
      ],
      depNameTemplate: "bats-core",
      datasourceTemplate: "github-releases",
      packageNameTemplate: "bats-core/bats-core",
    },
  ],
}
