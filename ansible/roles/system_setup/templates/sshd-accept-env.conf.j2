# {{ ansible_managed }}
# Allow specific client-forwarded environment variables (SSH SendEnv) into the
# session. Used so the GitHub Copilot CLI (COPILOT_GITHUB_TOKEN) and the GitHub
# CLI (GH_TOKEN) can authenticate on headless servers via tokens forwarded from
# the workstation (see the dotfiles `copilot-ssh` helper). No secret is stored
# here; sshd only permits the client to set these named variables.
AcceptEnv {{ sshd_accept_env_vars | join(' ') }}
