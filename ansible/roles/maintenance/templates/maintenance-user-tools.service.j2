[Unit]
Description=User-tools Maintenance - chezmoi / Homebrew / mise
After=network-online.target
Wants=network-online.target
After=maintenance-weekly.service
Conflicts=maintenance-weekly.service maintenance-daily.service

[Service]
Type=oneshot
User=root
WorkingDirectory={{ maintenance_workdir }}
ExecStart=/usr/bin/ansible-playbook \
  {{ maintenance_workdir }}/ansible/playbooks/maintenance-user-tools.yml \
  --inventory {{ maintenance_workdir }}/ansible/inventory/hosts.yml \
  --extra-vars "target_host={{ ansible_hostname }}"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maintenance-user-tools
