[Unit]
Description=dccd - Docker Compose CD Deployment
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User={{ maintenance_dccd_user }}
ExecStart=/bin/bash {{ maintenance_dccd_script_path }} \
  -d {{ maintenance_dccd_dir }} \
  -S %l \
  -k {{ maintenance_dccd_age_key }} \
  -x {{ maintenance_dccd_exclude }}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dccd-deploy
