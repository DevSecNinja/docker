#!/usr/bin/env bash
# Devcontainer Build Script
# Managed by Ansible - do not edit manually
# Phase 1 of 2: build a named Docker image for each repo.
# Always exits 0 so OnSuccess= chains to devcontainer-up.service for repos
# that did succeed. A summary of successes and failures is printed at the end.
# Logs are captured by systemd journal (journalctl -u devcontainer-build)

set -uo pipefail

export PATH="{{ devcontainer_cli_install_dir }}:{{ homebrew_prefix }}/bin:${PATH}"

PROJECTS_DIR="{{ devcontainer_prebuild_projects_dir }}"
DEFAULT_CONFIG="{{ devcontainer_prebuild_config_dir }}/devcontainer.json"

declare -a SUCCEEDED=()
declare -a FAILED=()
SUCCEEDED_COUNT=0
FAILED_COUNT=0

echo "=== Phase 1: devcontainer build ==="
echo "Scanning repos in ${PROJECTS_DIR}"

if [ ! -d "${PROJECTS_DIR}" ]; then
  echo "Projects directory ${PROJECTS_DIR} does not exist, skipping."
  exit 0
fi

# Include dot-prefixed directories (e.g. .github)
shopt -s dotglob

for repo_dir in "${PROJECTS_DIR}"/*/; do
  [ -d "${repo_dir}" ] || continue
  repo_name=$(basename "${repo_dir}")
  image_name="devcontainer-${repo_name}:latest"

  if [ -f "${repo_dir}.devcontainer/devcontainer.json" ]; then
    echo "--- Building ${repo_name} (own .devcontainer/) ---"
    if devcontainer build \
      --workspace-folder "${repo_dir}" \
      --image-name "${image_name}"; then
      SUCCEEDED+=("${repo_name}")
      SUCCEEDED_COUNT=$((SUCCEEDED_COUNT + 1))
    else
      echo "ERROR: build failed for ${repo_name}" >&2
      FAILED+=("${repo_name}")
      FAILED_COUNT=$((FAILED_COUNT + 1))
    fi
  else
    echo "--- Building ${repo_name} (default Debian config) ---"
    if devcontainer build \
      --workspace-folder "${repo_dir}" \
      --config "${DEFAULT_CONFIG}" \
      --image-name "${image_name}"; then
      SUCCEEDED+=("${repo_name}")
      SUCCEEDED_COUNT=$((SUCCEEDED_COUNT + 1))
    else
      echo "ERROR: build failed for ${repo_name}" >&2
      FAILED+=("${repo_name}")
      FAILED_COUNT=$((FAILED_COUNT + 1))
    fi
  fi
done

echo ""
echo "=== Phase 1 Summary ==="
echo "  Succeeded : ${SUCCEEDED_COUNT}"
for r in "${SUCCEEDED[@]:-}"; do [ -n "${r}" ] && echo "    [OK]   ${r}"; done
echo "  Failed    : ${FAILED_COUNT}"
for r in "${FAILED[@]:-}"; do [ -n "${r}" ] && echo "    [FAIL] ${r}"; done

if [ "${SUCCEEDED_COUNT}" -eq 0 ]; then
  echo "All builds failed - skipping devcontainer-up." >&2
  exit 1
fi

echo "Phase 1 complete - devcontainer-up will start for ${SUCCEEDED_COUNT} image(s)."
# Always exit 0 so OnSuccess= fires whenever at least one image was built
exit 0
