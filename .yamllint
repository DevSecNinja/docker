---
extends: default

rules:
  # Comply with ansible-lint requirements while keeping comments relaxed
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  # Long lines are unavoidable with image digests, Traefik labels, and URLs — not auto-fixable
  line-length: disable
  # Let yamlfmt handle document start markers
  document-start: disable
  # Allow 'on:' as a mapping key in GitHub Actions workflows
  truthy:
    allowed-values:
      - "true"
      - "false"
    check-keys: false
  indentation:
    spaces: 2
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .github/
  ansible/roles/geerlingguy.*
